#!/usr/bin/env bash

# ==========================================================
# Selector de fondos de pantalla.
#
# Muestra mediante Rofi los fondos disponibles para el tema
# activo, aplica el seleccionado y actualiza el estado del
# sistema para recordar la última imagen utilizada.
# ==========================================================

# Finaliza la ejecución si ocurre un error.
set -Eeuo pipefail

# Evita problemas con espacios en nombres de archivos.
IFS=$'\n\t'

# ----------------------------------------------------------
# Configuración
# ----------------------------------------------------------

COLORSCHEMES_DIR="$HOME/.config/colorschemes"
CURRENT_THEME_FILE="$COLORSCHEMES_DIR/.current-theme"
WALLPAPER_STATE="$COLORSCHEMES_DIR/.wallpaper-state"
ROFI_THEME="$HOME/.local/share/rofi/themes/wallpapers.rasi"

# ----------------------------------------------------------
# Funciones auxiliares
# ----------------------------------------------------------

info() {
    notify-send "Fondos de pantalla" "$1"
}

error() {
    notify-send "Error" "$1" -u critical
    exit 1
}

# ----------------------------------------------------------
# Obtiene el tema actualmente activo
# ----------------------------------------------------------

if [[ ! -f "$CURRENT_THEME_FILE" ]]; then
    error "No hay ningún tema activo."
fi

CURRENT_THEME=$(<"$CURRENT_THEME_FILE")

WALLPAPER_DIR="$COLORSCHEMES_DIR/$CURRENT_THEME/wallpapers"

# ----------------------------------------------------------
# Verifica que exista el directorio de fondos
# ----------------------------------------------------------

if [[ ! -d "$WALLPAPER_DIR" ]]; then
    error "El tema '$CURRENT_THEME' no contiene un directorio de fondos."
fi

# ----------------------------------------------------------
# Obtiene la lista de fondos disponibles
# ----------------------------------------------------------

mapfile -t WALLPAPERS < <(
    find "$WALLPAPER_DIR" \
        -type f \
        \( \
            -iname "*.jpg" \
            -o -iname "*.jpeg" \
            -o -iname "*.png" \
            -o -iname "*.svg" \
        \) |
    sort
)

if [[ ${#WALLPAPERS[@]} -eq 0 ]]; then
    error "No se encontraron fondos de pantalla."
fi

# ----------------------------------------------------------
# Obtiene el fondo actualmente seleccionado
# ----------------------------------------------------------

CURRENT_WALLPAPER=$(
    grep "^$CURRENT_THEME:" "$WALLPAPER_STATE" 2>/dev/null |
    cut -d':' -f2- ||
    true
)

# ----------------------------------------------------------
# Construye el menú de Rofi con miniaturas
# ----------------------------------------------------------

MENU=""

for WALLPAPER in "${WALLPAPERS[@]}"; do

    NAME=$(basename "$WALLPAPER")

    if [[ "$WALLPAPER" == "$CURRENT_WALLPAPER" ]]; then
        MENU+="● $NAME\0icon\x1f$WALLPAPER\n"
    else
        MENU+="$NAME\0icon\x1f$WALLPAPER\n"
    fi

done

# ----------------------------------------------------------
# Muestra el selector
# ----------------------------------------------------------

SELECTED=$(
    echo -en "$MENU" |
    rofi \
        -dmenu \
        -i \
        -show-icons \
        -p "Seleccionar fondo" \
        -theme "$ROFI_THEME"
)

# El usuario canceló el menú.
[[ -z "$SELECTED" ]] && exit 0

# Elimina el indicador del fondo activo.
SELECTED=${SELECTED#"● "}

# ----------------------------------------------------------
# Busca la ruta completa del fondo seleccionado
# ----------------------------------------------------------

SELECTED_PATH=""

for WALLPAPER in "${WALLPAPERS[@]}"; do

    if [[ "$(basename "$WALLPAPER")" == "$SELECTED" ]]; then
        SELECTED_PATH="$WALLPAPER"
        break
    fi

done

if [[ -z "$SELECTED_PATH" ]]; then
    error "No fue posible localizar el fondo seleccionado."
fi

# ----------------------------------------------------------
# Aplica el nuevo fondo de pantalla
# ----------------------------------------------------------

awww img \
    "$SELECTED_PATH" \
    --transition-type wipe \
    --transition-fps 144 \
    --transition-step 255

# ----------------------------------------------------------
# Guarda el último fondo utilizado para este tema
# ----------------------------------------------------------

touch "$WALLPAPER_STATE"

sed -i "/^$CURRENT_THEME:/d" "$WALLPAPER_STATE"

echo "$CURRENT_THEME:$SELECTED_PATH" >> "$WALLPAPER_STATE"

# ----------------------------------------------------------
# Actualiza el fondo utilizado por Hyprlock
# ----------------------------------------------------------

ln -sf \
    "$SELECTED_PATH" \
    "$HOME/.config/hypr/hyprlock/wallpaper"

# ----------------------------------------------------------
# Notificación final
# ----------------------------------------------------------

info "Fondo aplicado: $SELECTED"
