#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],

    // ==========================
    // Colores generales
    // ==========================

    background_color: Some("black"),

    text_color: Some("#e0e4db"),

    header_background_color: Some("black"),

    modal_background_color: Some("black"),

    modal_backdrop: false,

    // ==========================
    // Estilos generales
    // ==========================

    preview_label_style: (
        fg: "#c2c8bd"
    ),

    preview_metadata_group_style: (
        fg: "#baccb3",
        modifiers: "Bold"
    ),

    highlighted_item_style: (
        fg: "#a2d399",
        bg: "#1d211b",
        modifiers: "Bold"
    ),

    current_item_style: (
        fg: "#0b390e",
        bg: "#a2d399",
        modifiers: "Bold"
    ),

    borders_style: (
        fg: "#424940"
    ),

    highlight_border_style: (
        fg: "#a2d399"
    ),

    // ==========================
    // Símbolos
    // ==========================

    symbols: (
        song: "󰝚 ",
        dir: "󱍙 ",
        playlist: "󰲸 ",
        marker: "* ",
        ellipsis: "...",

        song_style: (
            fg: "#e0e4db"
        ),

        song_highlighted_style: Some((
            fg: "#a2d399",
            modifiers: "Bold"
        )),

        song_current_style: (
            fg: "#0b390e"
        ),

        dir_style: (
            fg: "#baccb3"
        ),

        dir_highlighted_style: None,

        dir_current_style: (
            fg: "#0b390e"
        ),

        playlist_style: (
            fg: "#a0cfd4"
        ),

        playlist_highlighted_style: None,

        playlist_current_style: (
            fg: "#0b390e"
        ),

        marker_style: (
            fg: "#a0cfd4"
        ),

        marker_highlighted_style: (
            fg: "#a0cfd4"
        ),

        marker_current_style: (
            fg: "#00363b",
            bg: "#a0cfd4"
        ),
    ),

    // ==========================
    // Niveles de log
    // ==========================

    level_styles: (
        info: (
            fg: "#baccb3",
            bg: "#10140f"
        ),

        warn: (
            fg: "#a0cfd4",
            bg: "#10140f"
        ),

        error: (
            fg: "#ffb4ab",
            bg: "#10140f"
        ),

        debug: (
            fg: "#8c9388",
            bg: "#10140f"
        ),

        trace: (
            fg: "#c2c8bd",
            bg: "#10140f"
        ),
    ),

    // ==========================
    // Barra de progreso
    // ==========================

    progress_bar: (
        symbols: ["", "█", "", "█", ""],

        track_style: (
            fg: "#424940",
            bg: "#10140f"
        ),

        elapsed_style: (
            fg: "#a2d399",
            bg: "#10140f"
        ),

        thumb_style: (
            fg: "#a2d399", 
            bg: "#424940"
        ),

        use_track_when_empty: false,
    ),

    // ==========================
    // Scrollbar
    // ==========================

    scrollbar: (
        symbols: ["┋", "█", "󰄿", "󰄼"],

        track_style: (
            fg: "#424940"
        ),

        ends_style: (
            fg: "#baccb3"
        ),

        thumb_style: (
            fg: "#baccb3"
        ),
    ),

    // ==========================
    // Barra de pestañas
    // ==========================

    tab_bar: (
        active_style: (
            fg: "#0b390e",
            bg: "#a2d399",
            modifiers: "Bold"
        ),

        inactive_style: (
            fg: "#c2c8bd",
            bg: "black"
        ),
    ),

    lyrics: (
        timestamp: false
    ),

    // ==========================
    // CAVA
    // ==========================

    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],

        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],

        inverted_bar_as_mask: false,

        bg_color: "black",

        bar_width: 3,

        bar_spacing: 1,

        orientation: Bottom,

        bar_color: Gradient({
            0:   "#baccb3",
            20:  "#a2d399",
            55:  "#a0cfd4",
            100: "#ffb4ab",
        }),
    ),
        browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (
                kind: Property(Filename)
            )
        ),
    ],

    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (
                    kind: Text("Unknown")
                )
            ),

            label_prop: (
                kind: Group([
                    (kind: Text("Artist ")),
                    (
                        kind: Text(""),
                        style: (
                            fg: "#baccb3"
                        )
                    )
                ])
            ),

            width: "20%",
        ),

        (
            prop: (
                kind: Property(Title),
                default: (
                    kind: Text("Unknown")
                )
            ),

            label_prop: (
                kind: Group([
                    (kind: Text("Title ")),
                    (
                        kind: Text(""),
                        style: (
                            fg: "#a2d399"
                        )
                    )
                ])
            ),

            width: "35%",
        ),

        (
            prop: (
                kind: Property(Album),
                style: (
                    fg: "#e0e4db"
                ),
                default: (
                    kind: Text("Unknown Album"),
                    style: (
                        fg: "#e0e4db"
                    )
                )
            ),

            label_prop: (
                kind: Group([
                    (kind: Text("Album ")),
                    (
                        kind: Text("󰀥"),
                        style: (
                            fg: "#a0cfd4"
                        )
                    )
                ])
            ),

            width: "30%",
        ),

        (
            prop: (
                kind: Property(Duration),
                default: (
                    kind: Text("-")
                )
            ),

            label_prop: (
                kind: Group([
                    (kind: Text("Length ")),
                    (
                        kind: Text(" "),
                        style: (
                            fg: "#c2c8bd"
                        )
                    )
                ])
            ),

            width: "15%",
            alignment: Right,
        ),
    ],
        layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(
                                parent: Rounded,
                                bottom_left: "├"
                            ),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(
                                parent: Rounded,
                                top_left: "┬",
                                top_right: "┬",
                                bottom_left: "┴",
                                bottom_right: "┴"
                            ),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(
                                parent: Rounded,
                                bottom_right: "┤"
                            ),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),

            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),

            (
                pane: Pane(TabContent),
                size: "100%",
            ),

            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "15",
                            borders: "ALL",
                            border_symbols: Inherited(
                                parent: Rounded,
                                top_right: "┬",
                                bottom_right: "┴"
                            ),
                            pane: Component("elapsed-duration")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [
                                (kind: Text(" ")),
                                (kind: Property(Status(QueueLength()))),
                                (kind: Text(" songs / ")),
                                (kind: Property(Status(QueueTimeTotal()))),
                                (kind: Text(" total time "))
                            ],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                )
            ),
        ],
    ),

    components: {        
        "state": Pane(Property(
            content: [
                (
                    kind: Text("["),
                    style: (
                        fg: "#baccb3",
                        modifiers: "Bold"
                    )
                ),
                (
                    kind: Property(Status(StateV2(
                        playing_label: "",
                        paused_label: "",
                        stopped_label: ""
                    ))),
                    style: (
                        fg: "#baccb3",
                        modifiers: "Bold"
                    )
                ),
                (
                    kind: Text("]"),
                    style: (
                        fg: "#baccb3",
                        modifiers: "Bold"
                    )
                ),
            ],
            align: Left,
        )),

        "title": Pane(Property(
            content: [
                (
                    kind: Property(Song(Title)),
                    style: (
                        fg: "#e0e4db",
                        modifiers: "Bold"
                    ),
                    default: (
                        kind: Text("No Song"),
                        style: (
                            fg: "#e0e4db",
                            modifiers: "Bold"
                        )
                    )
                ),
            ],
            align: Center,
            scroll_speed: 1
        )),

        "volume": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Property(
                        content: [
                            (kind: Text(""))
                        ]
                    ))
                ),

                (
                    size: "100%",
                    pane: Pane(Volume(
                        kind: Slider(
                            symbols: (
                                filled: "─",
                                thumb: "●",
                                track: "─"
                            ),
                            filled_style: (
                                fg: "#a2d399"
                            ),
                            track_style: (
                                fg: "#424940"
                            ),
                            thumb_style: (
                                fg: "#baccb3"
                            ),
                        )
                    ))
                ),

                (
                    size: "3",
                    pane: Pane(Property(
                        content: [
                            (
                                kind: Property(Status(Volume)),
                                style: (
                                    fg: "#baccb3"
                                )
                            )
                        ],
                        align: Right
                    ))
                ),

                (
                    size: "2",
                    pane: Pane(Property(
                        content: [
                            (
                                kind: Text("%"),
                                style: (
                                    fg: "#baccb3"
                                )
                            )
                        ]
                    ))
                ),
            ]
        ),

        "elapsed_and_bitrate": Pane(Property(
            content: [
                (
                    kind: Property(Status(Elapsed)),
                    style: (
                        fg: "#c2c8bd"
                    )
                ),

                (
                    kind: Text(" / "),
                    style: (
                        fg: "#8c9388"
                    )
                ),

                (
                    kind: Property(Status(Duration)),
                    style: (
                        fg: "#c2c8bd"
                    )
                ),

                (
                    kind: Group([
                        (
                            kind: Text(" ("),
                            style: (
                                fg: "#8c9388"
                            )
                        ),
                        (
                            kind: Property(Status(Bitrate)),
                            style: (
                                fg: "#a0cfd4"
                            )
                        ),
                        (
                            kind: Text(" kbps)"),
                            style: (
                                fg: "#8c9388"
                            )
                        ),
                    ])
                ),
            ],
            align: Left,
        )),
                "artist_and_album": Pane(Property(
            content: [
                (
                    kind: Property(Song(Artist)),
                    style: (
                        fg: "#a2d399",
                        modifiers: "Bold"
                    ),
                    default: (
                        kind: Text("Unknown"),
                        style: (
                            fg: "#a2d399",
                            modifiers: "Bold"
                        )
                    )
                ),

                (
                    kind: Text(" - "),
                    style: (
                        fg: "#8c9388"
                    )
                ),

                (
                    kind: Property(Song(Album)),
                    style: (
                        fg: "#c2c8bd"
                    ),
                    default: (
                        kind: Text("Unknown Album"),
                        style: (
                            fg: "#c2c8bd"
                        )
                    )
                ),
            ],
            align: Center,
            scroll_speed: 1
        )),

        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),

                (
                    size: "100%",
                    pane: Pane(Property(
                        content: [
                            (
                                kind: Property(Status(InputBuffer())),
                                style: (
                                    fg: "#a2d399"
                                )
                            )
                        ],
                        align: Left
                    ))
                ),

                (
                    size: "100",
                    pane: Pane(Property(
                        content: [

                            (
                                kind: Text("["),
                                style: (
                                    fg: "#8c9388",
                                    modifiers: "Bold"
                                )
                            ),

                            (
                                kind: Property(Status(RepeatV2(
                                    on_label: "  ",
                                    off_label: "  ",

                                    on_style: (
                                        fg: "#baccb3",
                                        modifiers: "Bold"
                                    ),

                                    off_style: (
                                        fg: "#c2c8bd",
                                        modifiers: "Dim"
                                    ),
                                )))
                            ),

                            (
                                kind: Property(Status(RandomV2(
                                    on_label: "  ",
                                    off_label: "  ",

                                    on_style: (
                                        fg: "#a0cfd4",
                                        modifiers: "Bold"
                                    ),

                                    off_style: (
                                        fg: "#c2c8bd",
                                        modifiers: "Dim"
                                    ),
                                )))
                            ),

                            (
                                kind: Property(Status(ConsumeV2(
                                    on_label: " 󰮯 ",
                                    off_label: " 󰮯 ",
                                    oneshot_label: " 󰮯 ",

                                    on_style: (
                                        fg: "#a2d399",
                                        modifiers: "Bold"
                                    ),

                                    off_style: (
                                        fg: "#c2c8bd",
                                        modifiers: "Dim"
                                    ),

                                    oneshot_style: (
                                        fg: "#ffb4ab",
                                        modifiers: "Bold"
                                    ),
                                )))
                            ),

                            (
                                kind: Property(Status(SingleV2(
                                    on_label: " 󰎤 ",
                                    off_label: " 󰎦 ",
                                    oneshot_label: " 󰇊 ",

                                    on_style: (
                                        fg: "#baccb3",
                                        modifiers: "Bold"
                                    ),

                                    off_style: (
                                        fg: "#c2c8bd",
                                        modifiers: "Dim"
                                    ),

                                    oneshot_style: (
                                        fg: "#ffb4ab",
                                        modifiers: "Bold"
                                    ),
                                )))
                            ),

                            (
                                kind: Text("]"),
                                style: (
                                    fg: "#8c9388",
                                    modifiers: "Bold"
                                )
                            ),

                        ],
                        align: Right
                    ))
                ),
            ]
        ),

        "elapsed-duration": Pane(Property(
            content: [
                (
                    kind: Property(Status(Elapsed)),
                    style: (
                        fg: "#baccb3"
                    )
                ),

                (
                    kind: Text(" / "),
                    style: (
                        fg: "#8c9388"
                    )
                ),

                (
                    kind: Property(Status(Duration)),
                    style: (
                        fg: "#baccb3"
                    )
                ),
            ],
            align: Center
        )),

        "custom_song_table_header": Pane(Property(
            content: [
                (
                    kind: Text(""),
                    style: (
                        fg: "#a2d399",
                        modifiers: "Bold"
                    )
                )
            ]
        )),
                "header_left": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Component("state")
                ),
                (
                    size: "1",
                    pane: Component("elapsed_and_bitrate")
                ),
            ]
        ),

        "header_center": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Component("title")
                ),
                (
                    size: "1",
                    pane: Component("artist_and_album")
                ),
            ]
        ),

        "header_right": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Component("volume")
                ),
                (
                    size: "1",
                    pane: Component("states")
                ),
            ]
        ),

        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        ),
    },
)