{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#1d254390",
                "editor.background": "#1d254390",
                "editor.foreground": "#c6c8d0",
                "text": "#c6c8d0",
                "text.muted": "#c6c8d070",
                "text.ignored": "#c6c8d040",
                "text.placeholder": "#c6c8d050",
                "ignored": "#c6c8d030",
                "element.hover": "#c6c8d030",
                "ghost_element.hover": "#2D9BFA30",
                "ghost_element.selected": "#2D9BFA30",
                "ghost_element.active": "#2D9BFA60",
                "border": "#1d2543",
                "editor.highlighted_line.background": "#2D9BFA10",
                "editor.active_line.background": "#2D9BFA10",
                "panel.background": "#1d254390",
                "title_bar.background": "#1d254390",
                "title_bar.inactive_background": "#1d254390",
                "status_bar.background": "#1d254390",
                "drop_target.background": "#1d254390",
                "elevated_surface.background": "#1d2543",
                "toolbar.background": "#1d254390",
                "tab_bar.background": "#1d254390",
                "tab.inactive_background": "#1d254390",
                "tab.active_background": "#2D9BFA30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#1d2543",
                "scrollbar.thumb.background": "#2D9BFA",
                "editor.gutter.background": "#1d254390",
                "terminal.background": "#1d254310",
                "terminal.foreground": "#c6c8d0",
                "terminal.dim_foreground": "#c6c8d0",
                "terminal.bright_foreground": "#c6c8d0",
                "terminal.ansi.black": "#1d2543",
                "terminal.ansi.red": "#2D9BFA",
                "terminal.ansi.green": "#39A7FA",
                "terminal.ansi.yellow": "#48B5F9",
                "terminal.ansi.blue": "#5DB9F5",
                "terminal.ansi.magenta": "#57C5F8",
                "terminal.ansi.cyan": "#6ACFF9",
                "terminal.ansi.white": "#c6c8d0",
                "terminal.ansi.bright_black": "#6b7084",
                "terminal.ansi.bright_red": "#2D9BFA",
                "terminal.ansi.bright_green": "#39A7FA",
                "terminal.ansi.bright_yellow": "#48B5F9",
                "terminal.ansi.bright_blue": "#5DB9F5",
                "terminal.ansi.bright_magenta": "#57C5F8",
                "terminal.ansi.bright_cyan": "#6ACFF9",
                "terminal.ansi.bright_white": "#c6c8d0",
                "modified": "#2D9BFA",
                "syntax": {
                    "attribute": {
                        "color": "#2D9BFA"
                    },
                    "boolean": {
                      "color": "#39A7FA"
                    },
                    "comment": {
                      "color": "#6b7084"
                    },
                    "comment.doc": {
                      "color": "#6b7084"
                    },
                    "constant": {
                      "color": "#39A7FA"
                    },
                    "function": {
                      "color": "#6ACFF9"
                    },
                    "keyword": {
                      "color": "#5DB9F5"
                    },
                    "number": {
                      "color": "#57C5F8"
                    },
                    "operator": {
                      "color": "#5DB9F5"
                    },
                    "string": {
                      "color": "#2D9BFA"
                    },
                    "variable": {
                      "color": "#39A7FA"
                    }
                },
                "players": [
                  {
                    "cursor": "#2D9BFA",
                    "background": "#1d2543",
                    "selection": "#2D9BFA30"
                  }
                ]
            }
        }
    ]
}
