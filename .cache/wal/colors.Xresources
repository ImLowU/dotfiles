! X colors.
! Generated by 'wal'
*foreground:        #c6c8d0
*background:        #1d2543
*.foreground:       #c6c8d0
*.background:       #1d2543
emacs*foreground:   #c6c8d0
emacs*background:   #1d2543
URxvt*foreground:   #c6c8d0
XTerm*foreground:   #c6c8d0
UXTerm*foreground:  #c6c8d0
URxvt*background:   [100]#1d2543
XTerm*background:   #1d2543
UXTerm*background:  #1d2543
URxvt*cursorColor:  #c6c8d0
XTerm*cursorColor:  #c6c8d0
UXTerm*cursorColor: #c6c8d0
URxvt*borderColor:  [100]#1d2543

! Colors 0-15.
*.color0: #1d2543
*color0:  #1d2543
*.color1: #2D9BFA
*color1:  #2D9BFA
*.color2: #39A7FA
*color2:  #39A7FA
*.color3: #48B5F9
*color3:  #48B5F9
*.color4: #5DB9F5
*color4:  #5DB9F5
*.color5: #57C5F8
*color5:  #57C5F8
*.color6: #6ACFF9
*color6:  #6ACFF9
*.color7: #c6c8d0
*color7:  #c6c8d0
*.color8: #6b7084
*color8:  #6b7084
*.color9: #2D9BFA
*color9:  #2D9BFA
*.color10: #39A7FA
*color10:  #39A7FA
*.color11: #48B5F9
*color11:  #48B5F9
*.color12: #5DB9F5
*color12:  #5DB9F5
*.color13: #57C5F8
*color13:  #57C5F8
*.color14: #6ACFF9
*color14:  #6ACFF9
*.color15: #c6c8d0
*color15:  #c6c8d0

! Black color that will not be affected by bold highlighting.
*.color66: #1d2543
*color66:  #1d2543

! Xclock colors.
XClock*foreground: #c6c8d0
XClock*background: #1d2543
XClock*majorColor:  rgba:c6/c8/d0/ff
XClock*minorColor:  rgba:c6/c8/d0/ff
XClock*hourColor:   rgba:c6/c8/d0/ff
XClock*minuteColor: rgba:c6/c8/d0/ff
XClock*secondColor: rgba:c6/c8/d0/ff

! Set depth to make transparency work.
URxvt*depth: 32
